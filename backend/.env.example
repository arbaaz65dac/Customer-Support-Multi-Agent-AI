# Copy to backend/.env and fill in locally. Never commit .env.

# App
APP_ENV=development
LOG_LEVEL=INFO

# MySQL (source of truth for products, customers, orders, tickets, chats)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=customer_support

# Groq-hosted LLM (langchain-groq)
GROQ_API_KEY=
GROQ_MODEL=

# Gemini embeddings for RAG (policy/FAQ documents only)
GEMINI_API_KEY=

# ChromaDB (persistent local store)
CHROMA_PERSIST_DIR=./chroma
